# usetulip/backend, which serves the better-auth admin login (/api/admin-auth).
API_URL=http://localhost:4000

# tulip-db Postgres (Supabase pooler, transaction mode). Server-only; bypasses RLS.
DATABASE_URL=postgresql://postgres.pdwtxnngciqdjbylyntk:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Realtime doorbell for the intake queue (public anon key; no row data is broadcast).
NEXT_PUBLIC_SUPABASE_URL=https://pdwtxnngciqdjbylyntk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: signed publish notices to the MCP server. Leave unset until mcp.usetulip.co exists;
# the MCP server reads published state from Supabase either way.
MCP_PUBLISH_WEBHOOK_URL=
MCP_PUBLISH_WEBHOOK_SECRET=

# AI block generation (lib/generator). Claude API key for the generator.
ANTHROPIC_API_KEY=
# Shared secret for POST /api/generate; must match the Vault secret
# generator_webhook_secret used by the projects insert trigger.
GENERATOR_WEBHOOK_SECRET=
# Server-only. Uploads delivery bundles to Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-assets
